# Local Postgres via docker/docker-compose.yml
DATABASE_URL="postgresql://kokan:kokan@localhost:5432/kokan"
# prisma/schema.prisma の directUrl が読む。本番では Vercel-Neon integration が
# pooled とは別の direct URL を注入する。ローカルは pooler が無いので同値で良い。
DATABASE_URL_UNPOOLED="postgresql://kokan:kokan@localhost:5432/kokan"

# Auth.js v5 — generate with: openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
# Set to "true" only when deploying behind a proxy (e.g. Vercel)
AUTH_TRUST_HOST=""

# Resend (https://resend.com) — magic-link provider + nudge emails
RESEND_API_KEY=""
EMAIL_FROM="kokan-nikki <noreply@your-domain.com>"

# OAuth providers — 両方 (ID と SECRET) 揃ったときのみ signin に出る。
# Google Cloud Console で OAuth 2.0 Client ID 作成、Authorized redirect URI に
# http://localhost:3000/api/auth/callback/google を登録
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# LINE Developers でチャネル作成 (LINE Login)、Callback URL に
# http://localhost:3000/api/auth/callback/line を登録 + email scope 申請
AUTH_LINE_ID=""
AUTH_LINE_SECRET=""

# Cron-side knobs
NUDGE_THRESHOLD_HOURS="72"
CRON_SECRET=""
